---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../lib/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  size?: 'lg' | 'sm';
  eager?: boolean;
}
const { project, lang, size = 'lg', eager = false } = Astro.props;
const { cover, hue, icon, title } = project.data;
---

{
  cover ? (
    <Image
      src={cover}
      alt={title[lang]}
      widths={[320, 640, 960]}
      sizes="(min-width: 1100px) 360px, (min-width: 720px) 50vw, 90vw"
      class:list={['cover', `cover-${size}`, 'cover-img']}
      loading={eager ? 'eager' : 'lazy'}
    />
  ) : (
    <div class:list={['cover', `cover-${size}`]} style={`--h:${hue}`} aria-hidden="true">
      <span class="cover-icon">
        <Icon name={icon} size={size === 'lg' ? 40 : 26} />
      </span>
    </div>
  )
}

<style>
  .cover {
    position: relative; display: grid; place-items: center; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(120% 90% at 85% 0%, hsl(calc(var(--h) + 25) 85% 58% / 0.55) 0%, transparent 55%),
      linear-gradient(145deg, hsl(var(--h) 70% 34%) 0%, hsl(calc(var(--h) - 20) 65% 16%) 100%);
  }
  .cover::before {
    content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0.35;
    background-image: linear-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.14) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(160deg, #000 10%, transparent 75%);
    -webkit-mask-image: linear-gradient(160deg, #000 10%, transparent 75%);
  }
  .cover-lg { aspect-ratio: 16 / 9; }
  .cover-sm { width: 100%; height: 100%; min-height: 88px; }
  .cover-icon {
    display: grid; place-items: center; width: 72px; height: 72px; border-radius: 20px; color: #fff;
    background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
  .cover-sm .cover-icon { width: 48px; height: 48px; border-radius: 14px; }
  .cover-img { width: 100%; object-fit: cover; }
</style>
