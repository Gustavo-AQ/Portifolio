---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import profile from '../assets/img/profile.jpg';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { about, interests, site } from '../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const factIcon = { degree: 'bx-book-open', city: 'bx-map', email: 'bx-envelope', born: 'bx-calendar' } as const;
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about-grid">
      <div class="about-photo" data-reveal>
        <Image src={profile} alt={site.name} widths={[360, 560, 720]} sizes="(min-width: 1024px) 380px, 100vw" class="photo" />
        <div class="photo-tag"><Icon name="bx-code-alt" size={18} />{lang === 'pt' ? 'Python · IA · Automação' : 'Python · AI · Automation'}</div>
      </div>

      <div class="about-body" data-reveal>
        <div class="section-head">
          <span class="kicker">{t('about.kicker')}</span>
          <h2 class="section-title" id="about-title">{t('about.title')}</h2>
        </div>
        <div class="about-text">
          {about.paragraphs[lang].map((p) => <p>{p}</p>)}
        </div>
        <ul class="facts">
          {
            about.facts.map((f) => (
              <li>
                <Icon name={factIcon[f.key]} size={20} />
                <span>
                  <small>{t(`about.facts.${f.key}`)}</small>
                  {f.key === 'email' ? <a href={`mailto:${f.value[lang]}`}>{f.value[lang]}</a> : f.value[lang]}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <h3 class="subhead interests-title">{t('about.interests')}</h3>
    <ul class="interests" data-reveal>
      {
        interests.map((i) => (
          <li>
            <span class="interest-icon"><Icon name={i.icon} size={20} /></span>
            {i.label[lang]}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about-grid { display: grid; gap: 32px; }
  .about-photo { position: relative; max-width: 260px; }
  @media (min-width: 640px) { .about-photo { max-width: 340px; } }
  .photo {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 25%; border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }
  .about-photo::after {
    content: ''; position: absolute; inset: 14px -14px -14px 14px; border: 2px solid var(--accent); border-radius: var(--radius-lg); z-index: -1; opacity: 0.55;
  }
  .photo-tag {
    position: absolute; left: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px;
    background: var(--header-bg); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--border-strong);
    font-size: 0.82rem; font-weight: 600; color: var(--text);
  }
  .photo-tag :global(.icon) { color: var(--accent-text); }
  .about-body .section-head { margin-bottom: 20px; }
  .about-text { display: grid; gap: 14px; color: var(--text-muted); font-size: 1.02rem; }
  .facts { list-style: none; display: grid; gap: 10px; margin-top: 26px; }
  .facts li {
    display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 12px; background: var(--surface); border: 1px solid var(--border);
  }
  .facts li > :global(.icon) { color: var(--accent-text); }
  .facts span { display: flex; flex-direction: column; min-width: 0; font-weight: 500; overflow-wrap: anywhere; }
  .facts small { color: var(--text-faint); font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; }

  .interests-title { margin-top: 56px; }
  .interests { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .interests li {
    display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 12px; background: var(--surface); border: 1px solid var(--border);
    font-size: 0.88rem; font-weight: 500; line-height: 1.3; transition: border-color 0.2s, transform 0.2s var(--ease);
  }
  .interests li:hover { border-color: var(--accent-ring); transform: translateY(-2px); }
  .interest-icon { display: grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: 10px; background: var(--accent-soft); color: var(--accent-text); }

  @media (min-width: 640px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .interests { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .about-grid { grid-template-columns: 380px 1fr; gap: 64px; align-items: center; }
    .about-photo { max-width: 420px; }
    .interests li { padding: 14px 16px; font-size: 0.94rem; }
  }
</style>
