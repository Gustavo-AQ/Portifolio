---
import { getIcon } from '../lib/icons';

interface Props {
  name: string;
  class?: string;
  size?: number | string;
}
const { name, class: className = '', size = '1em' } = Astro.props;
const svg = getIcon(name);
---

<span class:list={['icon', className]} style={`--icon-size:${typeof size === 'number' ? `${size}px` : size}`} set:html={svg} />
